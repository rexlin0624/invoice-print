    "pdfjs-dist": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "zxing-wasm": "^3.1.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "vite": "^5.4.9",
    "vitest": "^2.1.0"
  }
