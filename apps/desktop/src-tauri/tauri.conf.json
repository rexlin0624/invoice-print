{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "发票工具",
  "version": "0.2.0",
  "identifier": "dev.invoicetool.desktop",
  "mainBinaryName": "invoice-tool",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:5180",
    "beforeDevCommand": "pnpm --filter @invoice-tool/web dev",
    "beforeBuildCommand": "pnpm --filter @invoice-tool/web build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "发票工具",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "发票合并打印 / 查重 / 汇总",
    "longDescription": "本地优先的发票合并打印工具：拖入发票，自动识别、去重、按 A4 排版，一张纸放 2 张或 4 张，带裁切线，点一下打印。文件不上传。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
